{
  "name": "musicserver",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:server": "pnpm --filter @musicserver/server dev",
    "dev:web": "pnpm --filter @musicserver/web dev",
    "dev": "pnpm run --parallel dev:server dev:web",
    "build": "pnpm run -r build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "db:migrate": "pnpm --filter @musicserver/server prisma:migrate",
    "db:generate": "pnpm --filter @musicserver/server prisma:generate",
    "db:studio": "pnpm --filter @musicserver/server prisma:studio"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "systeminformation": "^5.31.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  }
}
